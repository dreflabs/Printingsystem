# Salin ke .env dan sesuaikan.

# PostgreSQL (Prisma)
DATABASE_URL="postgresql://user@localhost:5432/printflow?schema=public"

# NextAuth v5 — rahasia sesi/JWT
AUTH_SECRET="ganti-dengan-string-acak-panjang"

# Kunci HMAC untuk rantai hash audit_logs (anti-fraud). WAJIB diganti di produksi.
AUDIT_SECRET="ganti-dengan-string-acak-panjang"

# 1 = middleware melewati cek auth & RBAC (mode preview UI).
# Kosongkan / 0 di lingkungan nyata supaya proteksi rute aktif.
# Server MENOLAK START kalau nilainya 1 saat NODE_ENV=production.
AUTH_BYPASS="0"

# URL publik aplikasi (untuk tautan di email, mis. reset password).
APP_URL="https://printpilot.id"

# Token Bearer untuk endpoint background job (/api/jobs/*). WAJIB, min. 16 karakter.
# Cron eksternal memanggil tiap job dengan header Authorization: Bearer <token>.
JOBS_SECRET="ganti-dengan-string-acak-panjang"

# Bootstrap akun Super Admin pertama — dipakai HANYA oleh
# `npm run bootstrap:superadmin` (tidak dibaca aplikasi saat berjalan).
# Script-nya idempotent dan tidak pernah menghapus data, aman di produksi.
# Hapus SUPER_ADMIN_PASSWORD dari environment setelah akun terbuat.
SUPER_ADMIN_EMAIL="admin@printpilot.id"
SUPER_ADMIN_PASSWORD=""
SUPER_ADMIN_NAME="Super Admin"
# true = reset kata sandi & buka kunci akun yang sudah ada. Default: biarkan apa adanya.
SUPER_ADMIN_RESET_PASSWORD="false"

# ── Provider WhatsApp ────────────────────────────────────────────────
# WA_PROVIDER menentukan bentuk header & badan permintaan. Tiap provider beda,
# jadi ini WAJIB diisi benar — bukan sekadar URL + token.
#   fonnte  → Authorization: <token> (tanpa Bearer), {target, message}
#             URL default https://api.fonnte.com/send, boleh dikosongkan
#   wablas  → Authorization: <token> (tanpa Bearer), {phone, message}
#             URL: https://<domain-anda>.wablas.com/api/send-message
#   meta    → Authorization: Bearer <token>, payload WhatsApp Cloud API
#             URL: https://graph.facebook.com/v21.0/<PHONE_NUMBER_ID>/messages
#   generic → Bearer + {target, message} (perilaku lama)
# Token kosong = mode simulasi (log ke stdout), hanya di non-produksi.
# Setelah diisi, uji dulu: POST /api/jobs/test-notification {"wa":"08xxxxxxxxxx"}
WA_PROVIDER="fonnte"
WA_PROVIDER_URL=""
WA_PROVIDER_TOKEN=""

# ── Provider email ───────────────────────────────────────────────────
#   resend  → Authorization: Bearer, {from, to[], subject, text}
#             URL default https://api.resend.com/emails
#   brevo   → header api-key, {sender:{email}, to:[{email}], subject, textContent}
#             URL default https://api.brevo.com/v3/smtp/email
#   generic → Bearer + {from, to, subject, text} (perilaku lama)
# MAIL_FROM harus memakai domain yang sudah diverifikasi di provider.
MAIL_PROVIDER="resend"
MAIL_PROVIDER_URL=""
MAIL_PROVIDER_TOKEN=""
MAIL_FROM="no-reply@printpilot.id"
